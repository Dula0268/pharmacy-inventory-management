<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- =========================
       Pharmly color palette
       ========================= -->
  <Color x:Key="ColorAppBackground">#FFF6F7F4</Color>
  <Color x:Key="ColorSurface">#FFFFFFFF</Color>
  <Color x:Key="ColorBorderSoft">#FFE6EAE6</Color>
  <Color x:Key="ColorPrimaryDark">#FF022D2F</Color>
  <Color x:Key="ColorPrimary">#FF143E3A</Color>
  <Color x:Key="ColorAccent">#FFC0CEA6</Color>
  <Color x:Key="ColorText">#FF0F2928</Color>
  <Color x:Key="ColorMutedText">#FF6B7876</Color>

  <SolidColorBrush x:Key="AppBackground" Color="{StaticResource ColorAppBackground}" />
  <SolidColorBrush x:Key="Surface" Color="{StaticResource ColorSurface}" />
  <SolidColorBrush x:Key="BorderSoft" Color="{StaticResource ColorBorderSoft}" />
  <SolidColorBrush x:Key="PrimaryDark" Color="{StaticResource ColorPrimaryDark}" />
  <SolidColorBrush x:Key="Primary" Color="{StaticResource ColorPrimary}" />
  <SolidColorBrush x:Key="Accent" Color="{StaticResource ColorAccent}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource ColorText}" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource ColorMutedText}" />

  <!-- =========================
       Spacing & corners
       ========================= -->
  <CornerRadius x:Key="CornerSmall">8</CornerRadius>
  <CornerRadius x:Key="CornerMedium">10</CornerRadius>
  <CornerRadius x:Key="CornerLarge">14</CornerRadius>
  <CornerRadius x:Key="CornerPill">14</CornerRadius>
  <CornerRadius x:Key="CornerPillBig">18</CornerRadius>

  <Thickness x:Key="PaddingSmall">6</Thickness>
  <Thickness x:Key="PaddingMedium">12</Thickness>
  <Thickness x:Key="PaddingLarge">16</Thickness>

  <!-- subtle card shadow -->
  <DropShadowEffect x:Key="CardShadow"
                    Color="#000000"
                    BlurRadius="4"
                    ShadowDepth="1"
                    Opacity="0.06" />

  <!-- =========================
       Card border style
       ========================= -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CornerLarge}" />
    <Setter Property="Padding" Value="{StaticResource PaddingLarge}" />
    <Setter Property="Effect" Value="{StaticResource CardShadow}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- =========================
       Window base style
       ========================= -->
  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource AppBackground}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- =========================
       TextBlock for clear text rendering
       ========================= -->
  <Style TargetType="TextBlock">
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
  </Style>

  <!-- =========================
       TextBox / PasswordBox / ComboBox
       ========================= -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Margin" Value="6" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border CornerRadius="{StaticResource CornerMedium}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="2" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="PasswordBox">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Margin" Value="6" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border CornerRadius="{StaticResource CornerMedium}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="2" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Margin" Value="6" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- =========================
       Base button + AccentButton
       ========================= -->
  <Style TargetType="Button">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="Background" Value="#FFF3F5F5" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryDark}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource CornerMedium}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              TextBlock.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="#FFEAEFEF" />
              <Setter Property="BorderBrush" Value="#FFD1DCE0" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Background" Value="#FFDDE6E6" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource Primary}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource Primary}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource CornerPillBig}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" 
                              VerticalAlignment="Center"
                              TextBlock.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Opacity" Value="0.92" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Secondary button style for less prominent actions -->
  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryDark}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource CornerMedium}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" 
                              VerticalAlignment="Center"
                              TextBlock.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Opacity" Value="0.93" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Opacity" Value="0.87" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- =========================
       MODERN NAV TABS (TabControl / TabItem)
       - Compact, no extra vertical space
       - Scrollable headers
       - Clean rectangular tabs
       ========================= -->
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid KeyboardNavigation.TabNavigation="Local">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab header strip - compact, no padding -->
            <ScrollViewer Grid.Row="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="True">
              <TabPanel x:Name="HeaderPanel"
                        IsItemsHost="True"
                        Margin="0"
                        Background="Transparent"/>
            </ScrollViewer>

            <!-- Content area -->
            <ContentPresenter Grid.Row="1"
                              x:Name="PART_SelectedContentHost"
                              ContentSource="SelectedContent"
                              Margin="0"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TabItem">
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="MinWidth" Value="130" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryDark}" />
    <Setter Property="Background" Value="#FFF3F5F5" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="TabBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6,6,0,0"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter ContentSource="Header"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource Accent}" />
              <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource BorderSoft}" />
              <Setter Property="Foreground" Value="{StaticResource PrimaryDark}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>

            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="TabBorder" Property="Background" Value="#FFEAEFEF" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- =========================
       DataGrid modern look
       ========================= -->
  <Style TargetType="DataGrid">
    <Setter Property="GridLinesVisibility" Value="None" />
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="RowHeight" Value="34" />
    <Setter Property="ColumnHeaderHeight" Value="36" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="CanUserDeleteRows" Value="False" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="UseLayoutRounding" Value="True" />
  </Style>

  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="#FFF3F5F5" />
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Height" Value="36" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style TargetType="DataGridRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#FFF1F6F5" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="#FFEAF1ED" />
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
