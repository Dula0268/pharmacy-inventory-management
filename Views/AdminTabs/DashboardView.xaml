<UserControl x:Class="PharmacyInventory.Views.AdminTabs.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <StackPanel Margin="12">
            <TextBlock Text="Dashboard" FontSize="18" FontWeight="Bold" Margin="0 0 0 12" />

            <UniformGrid Columns="4" Rows="1" Margin="0 8 0 8" HorizontalAlignment="Stretch">
                <Border Background="#FFFFFF" CornerRadius="6" Padding="12" Margin="6" BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Today's Sales" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TodayTotal, StringFormat='LKR {0:N2}'}" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" CornerRadius="6" Padding="12" Margin="6" BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Expired Products" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ExpiredCount}" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" CornerRadius="6" Padding="12" Margin="6" BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Near Expiry (30d)" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding NearExpiryCount}" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" CornerRadius="6" Padding="12" Margin="6" BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Out of Stock" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding OutOfStockCount}" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="Summary" FontWeight="SemiBold" Margin="0 8 0 6" />
            <TextBlock Text="Use the tabs to access detailed views and reports." Foreground="#6B7280" />
        </StackPanel>
    </Grid>
</UserControl>
