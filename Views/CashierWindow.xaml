<Window x:Class="PharmacyInventory.Views.CashierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PharmacyInventory.Views"
        Title="Pharmacy Inventory - Cashier" 
        Height="700" Width="1200" 
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Grid Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Navbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderSoft}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Branding -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Cashier Point of Sale"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryDark}"
                               Margin="0,0,0,2" />
                    <TextBlock Text="Manage sales and inventory"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>

                <!-- Logout button -->
                <Button Grid.Column="1"
                        Style="{StaticResource AccentButton}"
                        Content="Logout"
                        Width="100"
                        Height="36"
                        VerticalAlignment="Center"
                        Click="OnLogoutClick" />
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- Products Section -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource BorderSoft}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Margin="0,0,12,0"
                    Padding="16">
                <DockPanel>
                    <!-- Search and Filter Header -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Available Products"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryDark}"
                                   Margin="0,0,0,10" />
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox x:Name="SearchBox"
                                     Width="220"
                                     Height="32"
                                     VerticalAlignment="Center"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button x:Name="SearchButton"
                                    Content="Search"
                                    Height="32"
                                    Width="80"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0"
                                    Command="{Binding SearchCommand}" />
                        </StackPanel>

                        <ComboBox x:Name="FilterBox"
                                  Height="32"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding FilterSelection}">
                            <ComboBoxItem Tag="">All Types</ComboBoxItem>
                            <ComboBoxItem Tag="Medicine">Medicine</ComboBoxItem>
                            <ComboBoxItem Tag="Grocery">Grocery</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <!-- Products DataGrid -->
                    <DataGrid x:Name="ProductsGrid"
                              AutoGenerateColumns="False"
                              ItemsSource="{Binding Products}"
                              SelectedItem="{Binding SelectedProduct}"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding Product.Type}" Width="70" />
                            <DataGridTextColumn Header="Product Name" Binding="{Binding Product.DisplayName}" Width="*" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding Product.QuantityOnHand}" Width="60" />
                            <DataGridTextColumn Header="Exp Date" Binding="{Binding Product.ExpDate}" Width="90" />
                            <DataGridTextColumn Header="Price" Binding="{Binding Product.SellingPrice, StringFormat='LKR {0:N2}'}" Width="100" />
                            <DataGridTextColumn Header="Status" Binding="{Binding AvailabilityStatus}" Width="110" />
                            <DataGridTemplateColumn Header="Action" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Add"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="8,4"
                                                FontSize="11"
                                                Height="28"
                                                Margin="2"
                                                Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Cart Section -->
            <Border Grid.Column="1"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource BorderSoft}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16">
                <DockPanel>
                    <!-- Cart Header -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="Shopping Cart"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryDark}"
                               Margin="0,0,0,12" />

                    <!-- Cart Items -->
                    <DataGrid DockPanel.Dock="Top"
                              x:Name="CartGrid"
                              AutoGenerateColumns="False"
                              ItemsSource="{Binding Cart}"
                              SelectedItem="{Binding SelectedCartItem}"
                              CanUserAddRows="False"
                              Height="280"
                              BorderThickness="0"
                              Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product" Binding="{Binding DisplayName}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding Qty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="50" IsReadOnly="False" />
                            <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat='LKR {0:N2}'}" Width="80" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Remove" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="4,2"
                                                FontSize="11"
                                                Height="24"
                                                Margin="2"
                                                Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Invoice Summary -->
                    <Border DockPanel.Dock="Bottom"
                            Background="#FFF3F5F5"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Subtotal:" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat='LKR {0:N2}'}" FontWeight="Medium" />
                            </Grid>

                            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,1" Padding="0,6" Margin="0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Total:" FontWeight="Bold" Foreground="{DynamicResource PrimaryDark}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat='LKR {0:N2}'}" FontWeight="Bold" Foreground="{DynamicResource Primary}" />
                                </Grid>
                            </Border>

                            <Button Grid.Row="2"
                                    Style="{StaticResource AccentButton}"
                                    x:Name="SellButton"
                                    Content="Complete Sale"
                                    Height="40"
                                    Margin="0,6,0,0"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Command="{Binding SellCommand}" />
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
