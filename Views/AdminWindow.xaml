<Window x:Class="PharmacyInventory.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tabs="clr-namespace:PharmacyInventory.Views.AdminTabs"
        mc:Ignorable="d"
        Title="Pharmacy Inventory - Admin"
        Width="1100" Height="750" WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Grid Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Navbar Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderSoft}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Branding -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Pharmacy Inventory"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryDark}"
                               Margin="0,0,0,2" />
                    <TextBlock Text="Admin Dashboard"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>

                <!-- Right: Logout Button -->
                <Button Grid.Column="1"
                        Style="{StaticResource AccentButton}"
                        Content="Logout"
                        Width="100"
                        Height="36"
                        VerticalAlignment="Center"
                        Click="OnLogoutClick" />
            </Grid>
        </Border>

        <!-- Tab Navigation -->
        <TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="20,12,20,0"
                    Margin="0">

            <!-- Tab Items -->
            <TabItem Header="Dashboard">
                <tabs:DashboardView Margin="16" />
            </TabItem>

            <TabItem Header="Add Products">
                <tabs:AddProductView Margin="16" />
            </TabItem>

            <TabItem Header="Search Products">
                <tabs:SearchProductsView Margin="16" />
            </TabItem>

            <TabItem Header="Expiration Details">
                <tabs:ExpirationView Margin="16" />
            </TabItem>

            <TabItem Header="View Inventory">
                <tabs:ViewInventoryView Margin="16" />
            </TabItem>

            <TabItem Header="Reports">
                <tabs:ReportsView Margin="16" />
            </TabItem>

            <TabItem Header="Settings">
                <tabs:SettingsView Margin="16" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
