<Window x:Class="PharmacyInventory.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pharmacy Inventory - Login"
        Width="440" Height="390"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}">

    <Grid Margin="18">
        <Border Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderSoft}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="Pharmacy Inventory"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryDark}" />
                    <TextBlock Text="Sign in to continue"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="Username"
                           Margin="0,0,0,6"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBox Grid.Row="2"
                         x:Name="UsernameBox"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"
                         KeyDown="UsernameBox_KeyDown"/>

                <TextBlock Grid.Row="3"
                           Text="Password"
                           Margin="0,0,0,6"
                           Foreground="{DynamicResource TextBrush}" />
                <PasswordBox Grid.Row="4"
                             x:Name="PasswordBox"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             Margin="0,0,0,10"
                             KeyDown="PasswordBox_KeyDown"/>

                <TextBlock Grid.Row="5"
                           x:Name="ErrorText"
                           Text="{Binding ErrorMessage}"
                           Foreground="Crimson"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap"
                           Visibility="{Binding ErrorVisibility}" />

                <Button Grid.Row="6"
                        x:Name="LoginButton"
                        Content="Login"
                        Style="{StaticResource AccentButton}"
                        Height="42"
                        VerticalAlignment="Bottom"
                        Margin="0,10,0,0"
                        Click="LoginButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
